{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "A second hotbar from the bottom row of your inventory, shown above the hotbar. Shift + scroll swaps them.",
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.rebelkeithy.dualhotbar.fabric.DualHotbarFabric"],
    "modmenu": ["io.github.rebelkeithy.dualhotbar.fabric.DualHotbarModMenu"]
  },
  "mixins": ["${mod_id}.mixins.json", "${mod_id}.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
